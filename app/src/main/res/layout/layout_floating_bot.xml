<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_circle_gold"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_chat_screen"
        android:layout_width="310dp"
        android:layout_height="420dp"
        android:orientation="vertical"
        android:background="#121212"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#1E1E1E"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Sri Veeramathi Amman Tex Bot"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_close_chat"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:background="#B71C1C"
                android:text="✕"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <ScrollView
            android:id="@+id/scroll_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/chat_messages_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:padding="10dp"
                    android:textColor="#69F0AE"
                    android:textSize="13sp"
                    android:text="வணக்கம்! நான் உங்கள் டெக்ஸ் போட். தறி விவரங்களை டைப் செய்யவும்." />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E1E1E"
            android:padding="6dp">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#000000"
                android:hint="Type entry here..."
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_send_chat"
                android:layout_width="44dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="#FFD54F"
                android:text="➤"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
